# ---- Agentrino backend environment ----
# Copy to .env and fill in real values. Do NOT commit .env.

# LLM (NVIDIA-hosted OpenAI-compatible endpoint)
NVIDIA_API_KEY=your_nvidia_api_key_here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Task-based model routing: task -> tier -> model.
# Defaults: title -> light, chat -> standard, oracle -> strong.
# Every tier falls back to LLM_MODEL (then the built-in default), so leaving
# these blank keeps a single-model setup. Pick the cheapest model that does
# each job well; move a task up a tier only when quality falls short.
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL_LIGHT=
# LLM_MODEL_STANDARD=
# LLM_MODEL_STRONG=
# LLM_MAX_TOKENS_LIGHT=4512   (reasoning models need room to think; only lower it for non-reasoning models)
# LLM_MAX_TOKENS_STANDARD=4512
# LLM_MAX_TOKENS_STRONG=8192
# Per-task tier override (light | standard | strong):
# LLM_TIER_TITLE=light
# LLM_TIER_CHAT=standard
# LLM_TIER_ORACLE=strong

# Vector store (Pinecone) — REQUIRED at startup
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=agentrino-index

# MongoDB (Atlas connection string, or local mongodb://localhost:27017)
MONGO_URI=mongodb+srv://user:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=agent_chatter

# Redis cache (Upstash REST)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
RECENT_MESSAGES_LIMIT=30
RECENT_MESSAGES_TTL=3600

# Admin console. Signing in exchanges this password for an expiring session
# token (sent as "Authorization: Bearer ..."); the password itself is never
# stored by the browser. Leave blank to disable the admin console entirely.
ADMIN_PASSWORD=
# Session lifetime in hours (default 8, clamped to 5 min .. 7 days). Sessions
# live in server memory, so a restart signs admins out.
# ADMIN_SESSION_TTL_HOURS=8

# CORS: comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# json (one structured object per line, with request_id) | text
LOG_FORMAT=json
